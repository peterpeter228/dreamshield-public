# Documentation template only; export values into the process environment.
# Keep replay/read-only defaults. Never add a private key or seed phrase.
APP_MODE=replay
HOST=127.0.0.1
PORT=3000
ALLOWED_CHAIN_ID=50383
READ_ONLY=true
ALLOW_TESTNET_WRITES=false
DATA_DIR=./data
# Shared doctor/application names: isolated EOA public address and doctor-verified pool.
# Leave unset until supplied/verified; never infer trading owner from a payout wallet.
DEMO_OWNER_ADDRESS=
DEMO_POOL_ADDRESS=
# Chain 50383 only; size/deposit come from verified market/registry reads, not constants.
# Position size bound (AUTH-20261027-DREAM-LOT-SIZE): exactly one market-minimum order
# on doctor-verified BTC (observed ≈13 grid lots = min13000/lot1000). Max concurrent
# native stops: 1–2. Do not default above market-min; do not switch markets here.
