# Documentation template only; export values into the process environment.
# Keep replay/read-only defaults. Never add a private key or seed phrase.
APP_MODE=replay
HOST=127.0.0.1
PORT=3000
ALLOWED_CHAIN_ID=50383
READ_ONLY=true
ALLOW_TESTNET_WRITES=false
DATA_DIR=./data
# Shared doctor/application names: isolated EOA public address and doctor-verified pool.
# DEMO_OWNER / OWNER (trading owner) — AUTH-20261027-DREAM-G1-AUTO. Public address only.
# Private key is held by hunter env (process.env.DREAMSHIELD_G1_PRIVATE_KEY); NEVER in repo.
# Not the registration payout wallet 0x54145b97d5CeCf72b9900C702a02774171574171.
DEMO_OWNER_ADDRESS=0x04b0A7AFD4Ab71C5d49c4bd578C2D9B8eA7DF36E
DEMO_POOL_ADDRESS=
# Chain 50383 (Somnia Tokyo) only; RPC https://api.hideki2.infra.testnet.somnia.network
# Size/deposit come from verified market/registry reads, not constants.
# Position size bound (AUTH-20261027-DREAM-LOT-SIZE): exactly one market-minimum order
# on doctor-verified BTC (observed ≈13 grid lots = min13000/lot1000). Max concurrent
# native stops: 1–2. Do not default above market-min; do not switch markets here.
# G1 live signs remain NOT_RUN (funding in flight); setting this address is not a trade auth.
